#!/bin/bash

APP_ROOT="${TRIM_APPDEST}"
DATA_ROOT="${TRIM_PKGVAR}"
APP_BINARY="${APP_ROOT}/bin/tmdb-sync-station"
ENV_FILE="${DATA_ROOT}/station.env"
LOG_FILE="${DATA_ROOT}/service.log"
PID_FILE="${DATA_ROOT}/service.pid"
PORT="${TRIM_SERVICE_PORT:-8788}"

is_running() {
    [ -r "${PID_FILE}" ] || return 1
    local pid
    pid="$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')"
    [[ "${pid}" =~ ^[0-9]+$ ]] || return 1
    kill -0 "${pid}" 2>/dev/null || return 1
    ps -p "${pid}" -o args= 2>/dev/null | grep -Fq "${APP_BINARY}"
}

start_service() {
    is_running && return 0
    rm -f "${PID_FILE}"
    if [ ! -x "${APP_BINARY}" ]; then
        echo "同步站服务程序不存在：${APP_BINARY}" > "${TRIM_TEMP_LOGFILE:-${LOG_FILE}}"
        return 1
    fi
    if [ ! -r "${ENV_FILE}" ]; then
        echo "请先将 station.env 配置写入 ${DATA_ROOT}，再启动同步站。" > "${TRIM_TEMP_LOGFILE:-${LOG_FILE}}"
        return 0
    fi
    set -a
    # The private env file is created for this NAS deployment and contains DATABASE_URL.
    . "${ENV_FILE}"
    set +a
    export TMDB_STATION_ADDR="0.0.0.0:${PORT}"
    export TMDB_STATION_WEB_ROOT="${APP_ROOT}/ui/www"
    nohup "${APP_BINARY}" >> "${LOG_FILE}" 2>&1 &
    local pid=$!
    printf '%s\n' "${pid}" > "${PID_FILE}"
    sleep 2
    if is_running; then return 0; fi
    echo "同步站启动失败，请检查 ${LOG_FILE}" > "${TRIM_TEMP_LOGFILE:-${LOG_FILE}}"
    rm -f "${PID_FILE}"
    return 1
}

stop_service() {
    is_running || { rm -f "${PID_FILE}"; return 0; }
    local pid
    pid="$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')"
    kill -TERM "${pid}" 2>/dev/null || true
    for _ in {1..10}; do
        kill -0 "${pid}" 2>/dev/null || break
        sleep 1
    done
    kill -0 "${pid}" 2>/dev/null && kill -KILL "${pid}" 2>/dev/null || true
    rm -f "${PID_FILE}"
}

mkdir -p "${DATA_ROOT}"
case "$1" in
    start) start_service ;;
    stop) stop_service ;;
    status) is_running && exit 0 || exit 3 ;;
    *) exit 1 ;;
esac
